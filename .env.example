# Copy to .env and adjust. Read by just on the host and by the containers.
# No secrets here: the app needs none.

# Port on localhost for `just up`, `just up-dev`, `just dev`, `just run` and `just docker-run`.
APP_PORT=8000

# Longest accepted input, in characters (text, or all chat messages together).
APP_MAX_TEXT_CHARS=200000

# Largest accepted request body, in bytes. Raise it together with APP_MAX_TEXT_CHARS:
# JSON can need up to 12 bytes per character (escaped emoji or control characters).
APP_MAX_BODY_BYTES=1000000

# Where prices fetched with "Fetch latest prices" are saved. just sets .app-data on the
# host and the image uses /app/data; leave unset to keep them in memory only.
# APP_DATA_DIR=

# uvicorn log level: critical, error, warning, info, debug, trace.
UVICORN_LOG_LEVEL=info
